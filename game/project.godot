config_version=5

[application]
config/name="Pocket Invasion"
config/version="1.1.0"
config/icon="res://assets/icons/app-icon.svg"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=725
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.741, 0.780, 0.624, 1)
